# Copy to .dev.vars for local dev. In production these come from GitHub secrets (see README).
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=  # any long random string: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
STADIA_API_KEY=      # without it, /api/places and /api/route return 503

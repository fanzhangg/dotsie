{
  "name": "waythread",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply waythread --local",
    "db:migrate:remote": "wrangler d1 migrations apply waythread --remote",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "TZ=America/Denver node --test test/*.test.js"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "better-auth": "^1.7.15",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.156.2"
  },
  "allowScripts": {
    "workerd@1.20261102.1": true
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker and its database keep the app's first name: renaming the Worker would move its workers.dev address,
  // and with it every trip link and connected assistant. A custom domain goes in APP_URL instead.
  "name": "waythread",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  // global_fetch_strictly_public: the OAuth provider fetches assistants' Client ID Metadata Documents, and this
  // keeps those fetches on the public internet (SSRF protection)
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // The frontend: web/ plus the shared ../design-system, copied into public/ by the build
  "build": { "command": "node scripts/build.mjs", "watch_dir": ["web", "../design-system"] },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The page itself ("/", which every link is: the rest is after the #) also goes to the Worker, so an old address
    // (the workers.dev one, once APP_URL is set) can send it on to the app's own; see "Moved" in src/index.ts
    "run_worker_first": ["/", "/index.html", "/api/*", "/.well-known/*"]
  },

  // Users, sessions, trip membership and the home-screen trip summaries
  "d1_databases": [
    { "binding": "DB", "database_name": "waythread", "database_id": "a1a82345-9cf8-42bf-a5f1-d59bd27bb598", "migrations_dir": "migrations" }
  ],

  // One Durable Object per trip: the trip's source of truth and its live-edit hub. And one per map tile whose sights
  // are being looked up (src/sights.ts), since Overpass can take longer to answer than a request can wait.
  "durable_objects": {
    "bindings": [{ "name": "TRIP", "class_name": "TripRoom" }, { "name": "SIGHTS", "class_name": "SightsLookup" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TripRoom"] }, { "tag": "v2", "new_sqlite_classes": ["SightsLookup"] }],

  // CACHE is what the Worker looks up and keeps: drive routes ("drive:…"), map tiles' sights ("sights:…") and what
  // Wikipedia says about places ("about:…", "place:…"). All of it can be looked up again, so it can be emptied at will.
  // OAUTH_KV is the MCP server's OAuth records (clients, grants, tokens), which can't: emptied, every connected
  // assistant would have to connect again. (They shared one namespace until 2026-11; the old one is OAUTH_KV's now.)
  "kv_namespaces": [
    { "binding": "CACHE", "id": "3d4a2553a77d42ca8c94bc87b74f4943" },
    { "binding": "OAUTH_KV", "id": "975e7b4349dc41db85e0b5d325f8182d" }
  ],

  // Sign-in steps per IP (an email lookup plus a sign-in counts twice), place searches plus route lookups per person,
  // MCP calls per person (an assistant's), and spots data lookups (/developer/spots, open to anyone) per IP, per minute.
  // namespace_id is any number unique to this account's rate limiters.
  "ratelimits": [
    { "name": "SIGNIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "MAPS_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "MCP_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "DATA_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
  ],

  // BETTER_AUTH_URL (the app's own origin) isn't set here: .dev.vars sets it for local dev, and
  // the deploy workflow passes the production one, so a deploy can't go out pointing at localhost.
  "observability": { "enabled": true }
}
